           :order 20
           :owner :internal
           :public {:phase :public.phase/onboarding
                    :label "Eligibility checked"}
           :internal {:label "Eligibility validation"}}
          {:id :step/documents
           :order 30
           :owner :client
           :public {:phase :public.phase/onboarding
                    :label "Documents collection"
                    :next-action "Upload the requested documents"}
           :internal {:label "Collect client documents"}}
          {:id :step/business-plan-approval
           :order 40
           :owner :internal
           :public {:phase :public.phase/licensing
                    :label "Pre-approval in progress"}
           :internal {:label "Business plan approval (Startup Saudi / MISA)"}}
          {:id :step/license-issued
           :order 50
           :owner :internal
           :public {:phase :public.phase/licensing
                    :label "License in progress"}
           :internal {:label "License issuance"}}
          {:id :step/cr-issued
           :order 60
           :owner :internal
           :public {:phase :public.phase/licensing
                    :label "Company registration in progress"}
           :internal {:label "Commercial Registration (CR)"}}
          {:id :step/tax-registration
           :order 70
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Government registrations in progress"}
           :internal {:label "ZATCA (VAT & TIN)"}}
          {:id :step/social-insurance
           :order 80
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Government registrations in progress"}
           :internal {:label "GOSI"}}
          {:id :step/national-address
           :order 90
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Government registrations in progress"}
           :internal {:label "National Address (SPL)"}}
          {:id :step/chamber-membership
           :order 100
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Government registrations in progress"}
           :internal {:label "Chamber of Commerce (COC)"}}
          {:id :step/workforce-portals
           :order 110
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Workforce portals setup"}
           :internal {:label "Qiwa + Ministry of Labor portals"}}
          {:id :step/immigration-portals
           :order 120
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Operational subscriptions setup"}
           :internal {:label "Muqeem + Mudad subscriptions"}}
          {:id :step/gm-visa
           :order 130
           :owner :internal
           :public {:phase :public.phase/activation
                    :label "Visa process in progress"}
           :internal {:label "General Manager visa / transfer"}}
          {:id :step/bank-account-opened
           :order 140
           :owner :internal
           :public {:phase :public.phase/banking
                    :label "Banking & handover"}
           :internal {:label "Bank account opening"}}
          {:id :step/close
           :order 150
           :owner :internal
           :public {:phase :public.phase/closed
                    :label "Closed"}
           :internal {:label "Close case"}}]}

