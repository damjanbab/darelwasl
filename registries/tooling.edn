 {:id :cap/tooling/registry-dump
  :title "Registry dump endpoint"
  :version "v1"
  :invocation "GET /api/registries[?name=schema|actions|views|integrations|agents|policies|internal|tooling|theme|automations]"
  :scope {:writes? false :reads [:registries]}
  :determinism :high
  :enforces [:registry-readonly]
  :related {:capabilities [:cap/tooling/edn-validate]}
  :gotchas ["Admin session required; returns raw registry EDN content for diagnostics only."]}

 {:id :cap/tooling/site-process
