 {:id :cap/tooling/import-check
  :title "Land registry import check"
  :version "v1"
  :invocation "scripts/checks.sh import"
  :files ["scripts/checks.sh"]
  :scope :shared
  :determinism {:fixtures [:fixtures/land-registry-sample]}
