   {:ident :task/status
    :type :db.type/keyword
    :cardinality :db.cardinality/one
    :doc "Task status enum"}
   {:ident :task/pending-reason
    :type :db.type/string
    :cardinality :db.cardinality/one
    :doc "Reason provided when task is pending"}
   {:ident :task/client
    :type :db.type/ref
    :cardinality :db.cardinality/one
    :doc "Linked client (ref to :client/id)"}
   {:ident :task/service-case
    :type :db.type/ref
    :cardinality :db.cardinality/one
    :doc "Linked service case (ref to :service.case/id, optional)"}
   {:ident :task/assignee
    :type :db.type/ref
    :cardinality :db.cardinality/one
    :doc "Assigned user"}
   {:ident :task/due-date
    :type :db.type/instant
    :cardinality :db.cardinality/one
    :doc "Optional due date"}
   {:ident :task/priority
    :type :db.type/keyword
    :cardinality :db.cardinality/one
    :doc "Priority enum"}
   {:ident :task/tags
    :type :db.type/ref
    :cardinality :db.cardinality/many
    :doc "Tags (refs to :tag/id)"}
   {:ident :task/archived?
    :type :db.type/boolean
    :cardinality :db.cardinality/one
    :doc "Archived flag"}
   {:ident :task/extended?
   :type :db.type/boolean
   :cardinality :db.cardinality/one
    :doc "Feature flag gating future fields"}
   {:ident :task/automation-key
    :type :db.type/string
    :cardinality :db.cardinality/one
    :unique :db.unique/value
