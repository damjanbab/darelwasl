{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.3"}
        metosin/reitit {:mvn/version "0.7.0"}
        metosin/muuntaja {:mvn/version "0.6.10"}
        ring/ring-core {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter {:mvn/version "1.12.1"}
        com.datomic/local {:mvn/version "1.0.291"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        org.clojure/data.csv {:mvn/version "1.0.1"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        clj-http/clj-http {:mvn/version "3.12.3"}
        dnsjava/dnsjava {:mvn/version "3.5.2"}
        org.jsoup/jsoup {:mvn/version "1.17.2"}
        org.apache.pdfbox/pdfbox {:mvn/version "2.0.30"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.14"}}
 :aliases {:dev {:main-opts ["-m" "darelwasl.main"]
                 :jvm-opts ["-Dclojure.main.report=stderr"]
                 :exec-fn darelwasl.main/-main}
           :terminal {:main-opts ["-m" "darelwasl.terminal.main"]
                      :jvm-opts ["-Dclojure.main.report=stderr"]}
           :seed {:main-opts ["-m" "darelwasl.fixtures"]
                  :jvm-opts ["-Dclojure.main.report=stderr"]}
           :import {:main-opts ["-m" "darelwasl.importer"]
                    :jvm-opts ["-Dclojure.main.report=stderr"]}
           :knowledge-crawl {:main-opts ["-m" "darelwasl.knowledge.pipeline"]
                             :jvm-opts ["-Dclojure.main.report=stderr"]}}}
